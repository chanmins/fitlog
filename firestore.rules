rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ── Username directory ────────────────────────────────────────────────
       Firebase Auth has no concept of a username — it signs in with an email.
       So "아이디로 로그인" needs one public hop: 아이디 → the email Firebase
       expects. That lookup necessarily happens BEFORE the user is
       authenticated, which is why `get` is open.

       `list` is closed on purpose, and the distinction matters: `get` can only
       return a document whose exact id you already typed, while `list` would
       hand a scraper the entire directory of usernames and addresses in one
       query. Open get + closed list means guessing "chanmin" reveals that one
       account and nothing reveals the rest.

       create: only a signed-in user, only pointing at their own uid, and only
       for a name nobody holds — Firestore applies `create` rules only when the
       document does not already exist, so that last part is what enforces
       uniqueness. Names are never editable; freeing one is a delete by its
       owner (account deletion), so a rename can't strand a stale pointer. */
    match /usernames/{username} {
      /* ⚠️ 이 문서에는 계정의 이메일 주소가 들어 있고, get 이 열려 있다.
         즉 아이디를 알거나 찍어 맞히면 인증 없이 그 계정의 이메일을 읽을 수
         있다. 아이디는 3~20자 소문자·숫자라 사전 공격이 쉽고, 공개 API 키만
         있으면 doc(id).get() 을 반복할 수 있다. list 를 막아 둔 것은 한 번에
         전부 훑는 것을 막을 뿐, 한 건씩 캐내는 것은 막지 못한다.

         알면서 열어 두는 이유:
         아이디로 로그인하려면 Firebase 가 요구하는 이메일을 '로그인 전에'
         알아내야 한다. 서버 없이 그걸 할 수 있는 길은 이 문서 하나뿐이다.
         (합성 주소 <id>@... 로 바꾸면 노출은 사라지지만 비밀번호 재설정
         메일이 그 가짜 주소로 가서 계정 복구가 끊긴다.)

         닫는 방법은 둘 중 하나다:
         1) App Check 를 붙이고 `allow get: if request.app != null;` 로 바꾼다.
            reCAPTCHA v3 는 2026년 현재 App Check 에서 지원 중단됐으므로
            reCAPTCHA Enterprise 키를 새로 만들고(Google Cloud → 보안 →
            reCAPTCHA), cloud.js 의 activate() 를 문자열 키가 아니라
            ReCaptchaEnterpriseProvider 로 바꿔야 한다. Enterprise 는 Cloud
            프로젝트에 결제 계정을 요구할 수 있다.
         2) Cloud Function 으로 아이디 → 이메일 변환을 서버에 두고 이 문서의
            공개 읽기를 아예 없앤다. Blaze 요금제가 필요하다.

         둘 다 이 저장소 밖의 준비가 필요해서 별건으로 남겨 둔다. */
      allow get: if true;
      allow list: if false;

      /* email 은 자기 것만 적을 수 있다.
         예전에는 아무 주소나 적을 수 있었다. 그러면 남의 이름으로 문서를
         만들어 두고 그 안에 피해자의 주소를 넣어, 비밀번호 재설정 메일이
         엉뚱한 사람에게 가게 만들 수 있었다. 계정을 빼앗지는 못하지만
         피싱의 발판으로는 충분하다. (u.email 이 없을 때 코드가 빈 문자열을
         적으므로 그것만 예외로 둔다 — 빈 값은 아무 데도 쓸 수 없다.) */
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt'])
                    && (request.resource.data.email == ''
                        || request.resource.data.email == request.auth.token.email);
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    /* Everything under a user's own document — profile, sessions, custom
       exercises — is readable and writable only by that user. */
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
