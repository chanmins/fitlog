<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- 웹뷰가 쓰는 localStorage/IndexedDB 는 백업에서 뺍니다. 기록의 진짜
         원본은 Firestore 이고, 오래된 백업이 복원되면서 최신 로컬 데이터를
         덮어쓰는 쪽이 훨씬 위험합니다. -->
    <exclude domain="database" path="." />
    <exclude domain="file" path="app_webview" />
</full-backup-content>
