# 이 파일을 keystore.properties 로 복사해 채우세요. (.gitignore 에 이미 들어 있습니다)
#
# 키스토어 만들기 (한 번만, 그리고 절대 잃어버리면 안 됩니다 —
# 이 키를 잃으면 같은 앱으로 업데이트를 올릴 수 없습니다):
#
#   keytool -genkey -v -keystore fitlog-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias fitlog
#
storeFile=../fitlog-release.jks
storePassword=CHANGE_ME
keyAlias=fitlog
keyPassword=CHANGE_ME
